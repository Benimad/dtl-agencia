# URL pública del sitio (sin barra final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.dtlagencia.com

# Clave con la que se firman las sesiones del panel. OBLIGATORIA en producción:
# mínimo 32 caracteres y distinta en cada entorno. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Opcional: webhook (Zapier, Make, n8n, Slack…) al que se reenvía cada candidatura.
# Si se deja vacío, la candidatura solo queda en el panel.
CANDIDATURA_WEBHOOK_URL=
