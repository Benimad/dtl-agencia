# ── Sitio ──────────────────────────────────────────────────────
# URL pública (sin barra final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.dtlagencia.com

# Clave con la que se firman las sesiones del panel. Mínimo 32 caracteres.
# Si falta, el panel sigue funcionando pero cierra la sesión en cada despliegue.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# ── Supabase ───────────────────────────────────────────────────
# Necesario en Vercel y en cualquier hosting sin disco propio: sin esto, lo
# que edite la agencia en el panel se pierde en el siguiente despliegue.
# Si se dejan vacías, la web guarda en data/db.json (bien en local y en VPS).
#
# Dónde encontrarlas: supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nombre del bucket de Storage donde van los carteles (público).
NEXT_PUBLIC_SUPABASE_BUCKET=carteles

# ── Opcional ───────────────────────────────────────────────────
# Webhook (Zapier, Make, n8n…) al que se reenvía cada candidatura.
CANDIDATURA_WEBHOOK_URL=

# Carpeta de datos cuando se usa el backend de archivo. Por defecto ./data
DATA_DIR=
